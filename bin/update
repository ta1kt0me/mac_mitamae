#!/bin/bash

# set -x
set -eu

cd "$(dirname "$0")/.."

git submodule update --remote

# bin/mitamae downloads the version written here
curl -fsSL https://api.github.com/repos/itamae-kitchen/mitamae/releases/latest \
  | ruby -rjson -e 'puts JSON.parse(STDIN.read)["tag_name"]' > bin/.mitamae-version

bin/mitamae local -y node.yml recipes/update.rb
