#!/bin/bash

set -eu

bin_dir=$(cd "$(dirname "$0")" && pwd)

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64)  target=aarch64-darwin ;;
  Darwin-x86_64) target=x86_64-darwin ;;
  Linux-x86_64)  target=x86_64-linux ;;
  *)
    echo "unsupported platform: $(uname -s)-$(uname -m)" >&2
    exit 1
    ;;
esac

# download the version in .mitamae-version unless it is already there
version=$(cat "$bin_dir/.mitamae-version")
binary=$bin_dir/mitamae-${target}-${version}
if [[ ! -x "$binary" ]]; then
  url=https://github.com/itamae-kitchen/mitamae/releases/download/${version}
  tmp_dir=$(mktemp -d)
  trap 'rm -rf "$tmp_dir"' EXIT
  curl -fsSL -o "$tmp_dir/mitamae-${target}" "$url/mitamae-${target}"
  curl -fsSL -o "$tmp_dir/SHA256SUMS" "$url/SHA256SUMS"
  (cd "$tmp_dir" && grep " mitamae-${target}\$" SHA256SUMS | shasum -a 256 -c - >&2)
  rm -f "$bin_dir"/mitamae-${target}-*
  chmod +x "$tmp_dir/mitamae-${target}"
  mv "$tmp_dir/mitamae-${target}" "$binary"
  rm -rf "$tmp_dir"
  trap - EXIT
fi

if [[ "$(uname -s)" = "Linux" && "${1:-}" = "local" ]]; then
  shift
  set -- local --shell=/bin/bash "$@"
fi

exec "$binary" "$@"
